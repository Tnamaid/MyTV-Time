# Copy this file to .env and fill it in (see docs/INSTALL.md).

# Your TMDB "API Key" (v3, the short one) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# REQUIRED: the address you open the app at, i.e. your Tailscale HTTPS name, no trailing slash.
# Buttons and forms are rejected (403) unless the page was opened from exactly this address.
ORIGIN=https://<machine>.<tailnet>.ts.net

# Time zone used for "today" (what has aired, what is up next).
TZ=Europe/Paris

# Where the database lives when running without Docker (default ./data/tracker.db).
# Docker ignores this: the database is always /data/tracker.db in the container = ./data/tracker.db on the PC.
# DB_PATH=./data/tracker.db

# Linux only: your user and group ids (run `id -u` and `id -g`), so the container writes ./data as
# you and not as root. Windows: leave these commented out.
# UID=1000
# GID=1000
